# Copy to .env for local testing with `npx netlify dev`, and set the same
# values in Netlify → Site configuration → Environment variables.
# Get them from Razorpay Dashboard → Account & Settings → API Keys.
# Test keys start with rzp_test_, live keys with rzp_live_.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
